{
  "name": "agentic-pr-review-gh-action",
  "version": "1.0.0",
  "description": "Sovereign GitHub Action for agentic code governance, synthetic review tribunals, and automated PR verification",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "build:cli": "ncc build src/cli.ts -o dist/cli --source-map --license licenses-cli.txt",
    "review": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-action",
    "agentic-ai",
    "code-review",
    "tribunal",
    "governance"
  ],
  "author": "Saul Fernandez & Tachikoma Core",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
